.env
.env.*
!.env.example

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/

# Ferramentas e editores
.vscode/
.idea/
*.swp

# Sistema operacional
.DS_Store
Thumbs.db

# Logs
*.log

# Builds
build/
dist/
*.egg-info/

# Cache de ferramentas
